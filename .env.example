# NVIDIA NIM API
NIM_API_KEY=nvapi-xxxxxxxxxxxxxxxxxxxxxxxx
NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NIM_MODEL=google/gemma-3-27b-it

# SearXNG
SEARXNG_HOST=localhost
SEARXNG_PORT=8888
SEARXNG_BASE_PATH=/search

# FastAPI
API_HOST=0.0.0.0
API_PORT=3000

# MCP server (standalone mode)
MCP_HOST=0.0.0.0
MCP_PORT=3001

# Crawl settings
DEFAULT_SEARCH_LIMIT=10
CONTENT_FILTER_THRESHOLD=0.6
WORD_COUNT_THRESHOLD=10
